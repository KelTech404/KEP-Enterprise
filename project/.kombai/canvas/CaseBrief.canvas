er);\nconst lenis = new Lenis({ duration: 1.1 });\nfunction raf(t){ lenis.raf(t); requestAnimationFrame(raf); }\nrequestAnimationFrame(raf);\n\n// Direction-reactive header\nconst header = document.getElementById('topbar');\nlet lastY = 0;\nlenis.on('scroll', ({ scroll, direction }) => {\n  if (scroll < 80) { header.style.transform='translateY(0)'; return; }\n  if (direction === 1 && scroll > lastY + 4) header.style.transform = 'translateY(-110%)';\n  else if (direction === -1) header.style.transform = 'translateY(0)';\n  lastY = scroll;\n});\nheader.style.transition = 'transform 0.45s cubic-bezier(.4,0,.2,1)';\n\n// Tab color sweep\nhover('.tab-link', el => {\n  if (el.classList.contains('active')) return;\n  animate(el, { color: '#CDA64E' }, { duration: 0.3 });\n  return () => animate(el, { color: '#E6E8EC' }, { duration: 0.3 });\n});\n\n// Folder stagger reveal on initial open\nconst folders = document.querySelectorAll('.folder');\ngsap.from(folders, { autoAlpha: 0, y: 30, duration: 0.7, ease: 'power3.out', stagger: 0.06, delay: 0.2 });\n\n// Cabinet panels entrance\ngsap.from('.cabinet-panel', { autoAlpha: 0, y: 24, duration: 0.6, stagger: 0.08, ease: 'power3.out' });\n\n// Summary numbers\ngsap.from('.serif-num, #cabinet header h2', { autoAlpha: 0, y: 16, duration: 0.6, stagger: 0.03, ease: 'power2.out', scrollTrigger: { trigger: '#cabinet', start: 'top 80%' } });\n\n// Matter detail mask wipe\ngsap.from('#matter-detail .b2.shadow-firm', { clipPath: 'inset(0 100% 0 0)', duration: 1, ease: 'power2.inOut', scrollTrigger: { trigger: '#matter-detail', start: 'top 70%' } });\n\n// Timeline stagger\ninView('.list-timeline', el => {\n  animate(el.querySelectorAll('li'), { opacity: [0,1], y: [20,0] }, { delay: stagger(0.1), duration: 0.5, ease: 'easeOut' });\n});\n\n// Calendar\nconst events = {\n  4:{type:'low',label:'Pemberton · Filing'},\n  6:{type:'low',label:'Status Mtg.'},\n  10:{type:'low',label:'GDPR Audit Prep'},\n  13:{type:'low',label:'8-K Transmittal'},\n  14:{type:'today',label:'TODAY'},\n  17:{type:'red',label:'SEC Supp. Production'},\n  19:{type:'red',label:'Pemberton Motion'},\n  22:{type:'amber',label:'Calloway Probate'},\n  24:{type:'amber',label:'Severance Reply'},\n  26:{type:'amber',label:'CFO Witness Prep'},\n  28:{type:'amber',label:'MSA Renewal'},\n};\nconst grid = document.getElementById('cal-cells');\nlet html = '';\n// Nov 2025 starts Saturday (1st). Days = 30.\nconst startOffset = 6; // Sat\nconst totalCells = 35;\nlet day = 1;\nfor (let i = 0; i < totalCells; i++) {\n  const isDay = i >= startOffset && day <= 30;\n  const d = isDay ? day : '';\n  const e = isDay ? events[day] : null;\n  const isWeekend = (i % 7 === 0) || (i % 7 === 6);\n  const bgClass = isWeekend ? 'bg-[var(--cream-2)]/40' : '';\n  const isToday = e && e.type === 'today';\n  const isLastCol = (i % 7 === 6);\n  const isLastRow = i >= 28;\n  html += `<div class=\"cal-cell ${isLastCol?'':'br2'} ${isLastRow?'':'bb2'} ${bgClass} p-2.5 relative ${isToday?'bg-[#26304A] text-[#E6E8EC]':''}\">`;\n  if (isDay) {\n    html += `<div class=\"font-mono text-[12px] ${isToday?'text-[#E6E8EC]':'text-[var(--navy)]'}\">${String(d).padStart(2,'0')}</div>`;\n    if (e && e.type !== 'today') {\n      const pillCls = e.type === 'red' ? 'bg-[var(--red)] text-[var(--cream)]' : e.type === 'amber' ? 'bg-[var(--amber)] text-[var(--navy)]' : 'border border-[var(--walnut)] text-[var(--walnut)]';\n      html += `<div class=\"mt-2 px-2 py-1 ${pillCls} font-mono text-[9px] uppercase tracking-wider truncate rounded-full\">${e.label}</div>`;\n    }\n    if (isToday) html += `<div class=\"mt-1 font-mono text-[9px] uppercase tracking-[0.2em] text-[var(--amber)]\">Today</div>`;\n  }\n  html += `</div>`;\n  if (isDay) day++;\n}\ngrid.innerHTML = html;\n\n// Calendar mask wipe\ngsap.fromTo('#cal-grid', { clipPath: 'inset(0 0 100% 0)' }, { clipPath: 'inset(0 0 0% 0)', duration: 1.1, ease: 'power2.inOut', scrollTrigger: { trigger: '#calendar', start: 'top 70%' } });\n\n// Ledger cascade\ngsap.from('#ledger-body tr', { autoAlpha: 0, y: 20, duration: 0.4, stagger: 0.05, ease: 'power3.out', scrollTrigger: { trigger: '#billing', start: 'top 70%' } });\n\n// Headline split fade\ngsap.from('section h2, section h1', { autoAlpha: 0, y: 30, duration: 0.8, ease: 'power3.out', scrollTrigger: { trigger: 'main', start: 'top 90%' } });\n</script>\n  ",
