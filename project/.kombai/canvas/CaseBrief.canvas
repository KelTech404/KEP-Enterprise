      "label": "CaseBrief",
      "html": "\n    <link rel=\"stylesheet\" href=\"https://unpkg.com/lenis@1/dist/lenis.css\" data-kid=\"0\" onerror=\"__crawlAsset&&__crawlAsset(this)\">\n<style data-kid=\"1\">\n@import url('https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n:root{\n  /* names kept for compatibility; values flipped to a dark, premium law-firm theme */\n  --cream:#181B22;     /* raised card/panel surface */\n  --cream-2:#20242E;   /* sub-header / more-raised surface */\n  --navy:#E6E8EC;      /* primary light \"ink\" (text + emphasis chips) */\n  --red:#D06A5C;       /* soft oxblood */\n  --walnut:#8B909C;    /* muted slate text */\n  --amber:#CDA64E;     /* brass / gold accent */\n  --ink:#E6E8EC;\n  --line:#2A2E38;      /* hairline borders */\n}\nbody{background:#0F1116;color:var(--ink);font-family:'Inter',sans-serif;}\n.font-serif{font-family:'Fraunces',serif;font-variation-settings:\"opsz\" 96;}\n.font-mono{font-family:'JetBrains Mono',monospace;font-variant-numeric:tabular-nums;letter-spacing:-.01em;}\n.font-body{font-family:'Inter',sans-serif;}\n.b2{border:1px solid var(--line);}\n.bt2{border-top:1px solid var(--line);}\n.bb2{border-bottom:1px solid var(--line);}\n.br2{border-right:1px solid var(--line);}\n.bl2{border-left:1px solid var(--line);}\n.shadow-firm{box-shadow:0 1px 0 rgba(255,255,255,.02) inset, 0 10px 30px -10px rgba(0,0,0,.6);}\n.tab-corner{clip-path:polygon(0 0, calc(100% - 24px) 0, 100% 100%, 0 100%);}\n.folder-tab{\n  position:relative;\n  background:#1C2029;\n}\n.folder-tab::before{\n  content:\"\";position:absolute;left:0;top:0;height:100%;width:4px;\n  background:var(--amber);\n}\n.folder-tab:hover{border-color:#3A404E;}\n.hatch{\n  background-image: repeating-linear-gradient(45deg, rgba(255,255,255,.015) 0 1px, transparent 1px 10px);\n}\n.dot::before{content:\"\";display:inline-block;width:8px;height:8px;border-radius:9999px;background:currentColor;margin-right:8px;vertical-align:middle;}\n.urgent-pulse{}\n.cabinet-panel{cursor:pointer;}\n.panel-body{overflow:hidden;}\n.tab-link{position:relative;}\n.tab-link.active::after{content:\"\";position:absolute;left:0;right:0;bottom:-14px;height:3px;background:var(--red);}\n.cal-cell{min-height:118px;}\nhr.rule{border:0;border-top:1px solid var(--line);}\n.serif-num{font-family:'Fraunces',serif;font-variation-settings:\"opsz\" 96;}\n.ledger-row:nth-child(odd){background:rgba(255,255,255,.02);}\n.unpaid{background:rgba(208,106,92,.10) !important;}\n::selection{background:var(--amber);color:#14161C;}\n.deco-line{height:1px;background:var(--line);}\n.deco-dline{border-top:1px solid var(--line);}\n.btn-ghost:hover{background:var(--navy);color:#14161C;}\n.flag-amber{background:var(--amber);color:#14161C;}\n.flag-red{background:var(--red);color:#FBEAE7;}\n.flag-low{background:transparent;color:var(--walnut);border:1px solid var(--walnut);}\n.ring-ink{outline:1px solid rgba(255,255,255,.12);}\n</style>\n\n\n<header id=\"topbar\" class=\"sticky top-0 z-40 bg-[var(--cream)] bb2\" data-kid=\"2\">\n  <div class=\"max-w-[1400px] mx-auto px-10 pt-5 pb-4 flex items-center\" data-kid=\"3\">\n    <div class=\"flex items-baseline gap-3\" data-kid=\"4\">\n      <div class=\"font-serif text-[28px] font-semibold tracking-tight text-[var(--navy)]\" data-kid=\"5\">Hartwell <span class=\"italic font-normal\" data-kid=\"6\">&amp;</span> Roe</div>\n      <div class=\"font-mono text-[10px] uppercase tracking-[0.2em] text-[var(--walnut)] border-l-2 border-[var(--navy)] pl-3\" data-kid=\"7\">Est. MCMLXXII · Attorneys at Law</div>\n    </div>\n    <nav class=\"mx-auto flex items-center gap-12 font-body text-[14px] text-[var(--navy)]\" data-kid=\"8\">\n      <a class=\"tab-link active font-medium\" data-tab=\"clients\" data-kid=\"9\">Clients</a>\n      <a class=\"tab-link\" data-tab=\"calendar\" data-kid=\"10\">Calendar</a>\n      <a class=\"tab-link\" data-tab=\"billing\" data-kid=\"11\">Billing</a>\n    </nav>\n    <div class=\"flex items-center gap-5 text-[var(--navy)]\" data-kid=\"12\">\n      <div class=\"font-mono text-[11px] text-[var(--walnut)]\" data-kid=\"13\">VOL. XIV · NO. 042</div>\n      <div class=\"w-px h-5 bg-[var(--navy)]/30\" data-kid=\"14\"></div>\n      <i class=\"ti ti-search text-[18px]\" data-kid=\"15\"></i>\n      <i class=\"ti ti-bell text-[18px]\" data-kid=\"16\"></i>\n      <div class=\"w-8 h-8 rounded-full bg-[var(--navy)] text-[var(--cream)] font-mono text-[11px] flex items-center justify-center\" data-kid=\"17\">EH</div>\n    </div>\n  </div>\n</header>\n\n<main class=\"max-w-[1400px] mx-auto px-10 py-10\" data-kid=\"18\">\n\n\n<section class=\"mb-10\" data-kid=\"19\">\n  <div class=\"flex items-end justify-between mb-6\" data-kid=\"20\">\n    <div data-kid=\"21\">\n      <div class=\"font-mono text-[11px] uppercase tracking-[0.25em] text-[var(--walnut)] mb-3\" data-kid=\"22\">§ I — Client Portfolios · Filing Cabinet</div>\n      <h1 class=\"font-serif text-[64px] leading-[0.95] text-[var(--navy)] font-semibold\" data-kid=\"23\">The Active <em class=\"text-[var(--red)]\" data-kid=\"24\">Docket</em></h1>\n      <p class=\"font-body text-[15px] text-[var(--walnut)] mt-3 max-w-xl\" data-kid=\"25\">Five client portfolios. Twenty-three open matters. Seven deadlines within fourteen days. Select a panel to review.</p>\n    </div>\n    <div class=\"text-right\" data-kid=\"26\">\n      <div class=\"font-mono text-[11px] uppercase tracking-[0.2em] text-[var(--walnut)]\" data-kid=\"27\">As of</div>\n      <div class=\"font-mono text-[18px] text-[var(--navy)] mt-1\" data-kid=\"28\">2025·11·14 — 09:42 EST</div>\n      <div class=\"deco-dline w-40 ml-auto mt-2\" data-kid=\"29\"></div>\n      <div class=\"font-mono text-[10px] text-[var(--walnut)] mt-2\" data-kid=\"30\">Filed by — E. Hartwell, Esq.</div>\n    </div>\n  </div>\n\n  \n  <div class=\"b2 bg-[var(--cream)] shadow-firm grid grid-cols-5\" data-kid=\"31\">\n    <div class=\"p-5 br2\" data-kid=\"32\">\n      <div class=\"font-mono text-[10px] uppercase tracking-[0.2em] text-[var(--walnut)]\" data-kid=\"33\">Clients</div>\n      <div class=\"font-serif text-[40px] leading-none text-[var(--navy)] mt-2 font-semibold\" data-kid=\"34\">05</div>\n    </div>\n    <div class=\"p-5 br2\" data-kid=\"35\">\n      <div class=\"font-mono text-[10px] uppercase tracking-[0.2em] text-[var(--walnut)]\" data-kid=\"36\">Open Matters</div>\n      <div class=\"font-serif text-[40px] leading-none text-[var(--navy)] mt-2 font-semibold\" data-kid=\"37\">23</div>\n    </div>\n    <div class=\"p-5 br2\" data-kid=\"38\">\n      <div class=\"font-mono text-[10px] uppercase tracking-[0.2em] text-[var(--walnut)]\" data-kid=\"39\">Critical · ≤7d</div>\n      <div class=\"font-serif text-[40px] leading-none text-[var(--red)] mt-2 font-semibold\" data-kid=\"40\">04</div>\n    </div>\n    <div class=\"p-5 br2\" data-kid=\"41\">\n      <div class=\"font-mono text-[10px] uppercase tracking-[0.2em] text-[var(--walnut)]\" data-kid=\"42\">Approaching</div>\n      <div class=\"font-serif text-[40px] leading-none text-[var(--amber)] mt-2 font-semibold\" data-kid=\"43\">07</div>\n    </div>\n    <div class=\"p-5\" data-kid=\"44\">\n      <div class=\"font-mono text-[10px] uppercase tracking-[0.2em] text-[var(--walnut)]\" data-kid=\"45\">Billable · MTD</div>\n      <div class=\"font-serif text-[40px] leading-none text-[var(--navy)] mt-2 font-semibold\" data-kid=\"46\">187.4<span class=\"font-mono text-[14px] text-[var(--walnut)] ml-1\" data-kid=\"47\">h</span></div>\n    </div>\n  </div>\n</section>\n\n\n<section id=\"cabinet\" class=\"space-y-[10px]\" data-kid=\"48\">\n\n  \n  <article class=\"cabinet-panel b2 bg-[var(--cream)] shadow-firm\" data-open=\"true\" data-kid=\"49\">\n    <header class=\"grid grid-cols-12 items-center bb2 bg-[var(--cream-2)]\" data-kid=\"50\">\n      <div class=\"col-span-1 br2 py-5 px-5 text-center\" data-kid=\"51\">\n        <div class=\"font-mono text-[10px] text-[var(--walnut)] uppercase tracking-widest\" data-kid=\"52\">File</div>\n        <div class=\"font-mono text-[18px] text-[var(--navy)] mt-1\" data-kid=\"53\">01</div>\n      </div>\n      <div class=\"col-span-5 px-6 py-5 br2\" data-kid=\"54\">\n        <div class=\"font-mono text-[10px] uppercase tracking-[0.2em] text-[var(--walnut)]\" data-kid=\"55\">Client · Corporate</div>\n        <h2 class=\"font-serif text-[34px] leading-none text-[var(--navy)] mt-1 font-semibold\" data-kid=\"56\">Westbrook <em data-kid=\"57\">Industries</em>, LLC</h2>\n      </div>\n      <div class=\"col-span-2 px-6 py-5 br2\" data-kid=\"58\">\n        <div class=\"font-mono text-[10px] uppercase tracking-[0.2em] text-[var(--walnut)]\" data-kid=\"59\">Active Matters</div>\n        <div class=\"font-mono text-[26px] text-[var(--navy)] mt-1\" data-kid=\"60\">07</div>\n      </div>\n      <div class=\"col-span-3 px-6 py-5 br2\" data-kid=\"61\">\n        <div class=\"font-mono text-[10px] uppercase tracking-[0.2em] text-[var(--walnut)]\" data-kid=\"62\">Next Deadline</div>\n        <div class=\"font-mono text-[18px] text-[var(--red)] mt-1 flex items-center gap-2\" data-kid=\"63\"><i class=\"ti ti-alert-triangle-filled text-[16px]\" data-kid=\"64\"></i> 2025·11·17 · 3d</div>\n      </div>\n      <div class=\"col-span-1 px-5 py-5 text-right\" data-kid=\"65\">\n        <i class=\"ti ti-folder-open text-[28px] text-[var(--walnut)]\" data-kid=\"66\"></i>\n      </div>\n    </header>\n\n    \n    <div class=\"panel-body p-8 hatch\" data-kid=\"67\">\n      <div class=\"flex items-center justify-between mb-6\" data-kid=\"68\">\n        <div class=\"font-mono text-[10px] uppercase tracking-[0.25em] text-[var(--walnut)]\" data-kid=\"69\">Hanging Folders · seven matters</div>\n        <div class=\"flex items-center gap-4 font-mono text-[11px] text-[var(--walnut)]\" data-kid=\"70\">\n          <span class=\"flex items-center gap-1.5\" data-kid=\"71\"><span class=\"w-2 h-2 bg-[var(--red)]\" data-kid=\"72\"></span>Critical</span>\n          <span class=\"flex items-center gap-1.5\" data-kid=\"73\"><span class=\"w-2 h-2 bg-[var(--amber)]\" data-kid=\"74\"></span>Approaching</span>\n          <span class=\"flex items-center gap-1.5\" data-kid=\"75\"><span class=\"w-2 h-2 border border-[var(--walnut)]\" data-kid=\"76\"></span>Routine</span>\n        </div>\n      </div>\n\n      \n      <div class=\"grid grid-cols-3 gap-x-6 gap-y-5\" id=\"folder-grid\" data-kid=\"77\">\n        \n        <div class=\"flex flex-col gap-5\" data-kid=\"78\">\n          <div class=\"folder b2 folder-tab pl-6 pr-5 py-5 cursor-pointer\" data-kid=\"79\">\n            <div class=\"flex items-start justify-between\" data-kid=\"80\">\n              <div data-kid=\"81\">\n                <div class=\"font-mono text-[10px] uppercase tracking-[0.2em] text-[var(--walnut)]\" data-kid=\"82\">M-2401 · Litigation</div>\n                <div class=\"font-serif text-[22px] leading-tight text-[var(--navy)] mt-1 font-semibold\" data-kid=\"83\">SEC Inquiry Response</div>\n              </div>\n              <span class=\"flag-red px-2 py-0.5 font-mono text-[10px] uppercase tracking-wider urgent-pulse\" data-kid=\"84\"><i class=\"ti ti-alert-triangle\" data-kid=\"85\"></i> High</span>\n            </div>\n            <div class=\"deco-line my-4 opacity-30\" data-kid=\"86\"></div>\n            <div class=\"flex justify-between items-end\" data-kid=\"87\">\n              <div data-kid=\"88\">\n                <div class=\"font-mono text-[10px] text-[var(--walnut)]\" data-kid=\"89\">Filing Deadline</div>\n                <div class=\"font-mono text-[16px] text-[var(--red)]\" data-kid=\"90\">2025·11·17</div>\n              </div>\n              <div class=\"font-mono text-[10px] uppercase text-[var(--walnut)]\" data-kid=\"91\"><span class=\"dot text-[var(--red)]\" data-kid=\"92\"></span>In Discovery</div>\n            </div>\n          </div>\n          <div class=\"folder b2 folder-tab pl-6 pr-5 py-5\" data-kid=\"93\">\n            <div class=\"font-mono text-[10px] uppercase tracking-[0.2em] text-[var(--walnut)]\" data-kid=\"94\">M-2387 · M&amp;A</div>\n            <div class=\"font-serif text-[20px] text-[var(--navy)] mt-1 font-semibold\" data-kid=\"95\">Acquisition · Beale &amp; Co.</div>\n            <div class=\"deco-line my-4 opacity-30\" data-kid=\"96\"></div>\n            <div class=\"flex justify-between items-end\" data-kid=\"97\">\n              <div class=\"font-mono text-[16px] text-[var(--walnut)]\" data-kid=\"98\">2025·12·02</div>\n              <div class=\"font-mono text-[10px] uppercase text-[var(--walnut)]\" data-kid=\"99\"><span class=\"dot text-[var(--walnut)]\" data-kid=\"100\"></span>Drafting</div>\n            </div>\n          </div>\n        </div>\n\n        \n        <div class=\"flex flex-col gap-5 mt-8\" data-kid=\"101\">\n          <div class=\"folder b2 folder-tab pl-6 pr-5 py-5\" data-kid=\"102\">\n            <div class=\"flex items-start justify-between\" data-kid=\"103\">\n              <div data-kid=\"104\">\n                <div class=\"font-mono text-[10px] uppercase tracking-[0.2em] text-[var(--walnut)]\" data-kid=\"105\">M-2399 · Employment</div>\n                <div class=\"font-serif text-[20px] text-[var(--navy)] mt-1 font-semibold\" data-kid=\"106\">Severance Negotiation</div>\n              </div>\n              <span class=\"flag-amber px-2 py-0.5 font-mono text-[10px] uppercase tracking-wider\" data-kid=\"107\"><i class=\"ti ti-alert-triangle\" data-kid=\"108\"></i> Med</span>\n            </div>\n            <div class=\"deco-line my-4 opacity-30\" data-kid=\"109\"></div>\n            <div class=\"flex justify-between items-end\" data-kid=\"110\">\n              <div class=\"font-mono text-[16px] text-[var(--amber)]\" data-kid=\"111\">2025·11·24</div>\n              <div class=\"font-mono text-[10px] uppercase text-[var(--walnut)]\" data-kid=\"112\"><span class=\"dot text-[var(--amber)]\" data-kid=\"113\"></span>Pending Reply</div>\n            </div>\n          </div>\n          <div class=\"folder b2 folder-tab pl-6 pr-5 py-5\" data-kid=\"114\">\n            <div class=\"font-mono text-[10px] uppercase tracking-[0.2em] text-[var(--walnut)]\" data-kid=\"115\">M-2371 · IP</div>\n            <div class=\"font-serif text-[20px] text-[var(--navy)] mt-1 font-semibold\" data-kid=\"116\">Trademark · \"Westgrid™\"</div>\n            <div class=\"deco-line my-4 opacity-30\" data-kid=\"117\"></div>\n            <div class=\"flex justify-between items-end\" data-kid=\"118\">\n              <div class=\"font-mono text-[16px] text-[var(--walnut)]\" data-kid=\"119\">2026·01·15</div>\n              <div class=\"font-mono text-[10px] uppercase text-[var(--walnut)]\" data-kid=\"120\"><span class=\"dot text-[var(--walnut)]\" data-kid=\"121\"></span>USPTO Review</div>\n            </div>\n          </div>\n          <div class=\"folder b2 folder-tab pl-6 pr-5 py-5\" data-kid=\"122\">\n            <div class=\"font-mono text-[10px] uppercase tracking-[0.2em] text-[var(--walnut)]\" data-kid=\"123\">M-2360 · Compliance</div>\n            <div class=\"font-serif text-[20px] text-[var(--navy)] mt-1 font-semibold\" data-kid=\"124\">Annual GDPR Audit</div>\n            <div class=\"deco-line my-4 opacity-30\" data-kid=\"125\"></div>\n            <div class=\"flex justify-between items-end\" data-kid=\"126\">\n              <div class=\"font-mono text-[16px] text-[var(--walnut)]\" data-kid=\"127\">2026·02·28</div>\n              <div class=\"font-mono text-[10px] uppercase text-[var(--walnut)]\" data-kid=\"128\"><span class=\"dot text-[var(--walnut)]\" data-kid=\"129\"></span>Scheduled</div>\n            </div>\n          </div>\n        </div>\n\n        \n        <div class=\"flex flex-col gap-5 mt-4\" data-kid=\"130\">\n          <div class=\"folder b2 folder-tab pl-6 pr-5 py-5\